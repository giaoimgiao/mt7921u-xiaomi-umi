diff -ruN a/mt76/mt76_kernel_compat.h b/mt76/mt76_kernel_compat.h
--- a/mt76/mt76_kernel_compat.h	1970-01-01 00:00:00.000000000 +0000
+++ b/mt76/mt76_kernel_compat.h	2026-10-14 21:28:22.058790088 +0000
@@ -0,0 +1,236 @@
+/* SPDX-License-Identifier: ISC
+ *
+ * Kernel-version glue for the backported mt76 USB driver.
+ *
+ * The driver comes from a 5.19-era tree while the target kernel is a 4.19
+ * vendor kernel, so a handful of helpers simply do not exist here. Everything
+ * in this file is either a constant that this kernel never uses, or a thin
+ * wrapper around an equivalent that does exist.
+ */
+#ifndef __MT76_KERNEL_COMPAT_H
+#define __MT76_KERNEL_COMPAT_H
+#include <linux/sched.h>
+#include <linux/sched/types.h>
+#include <linux/timekeeping.h>
+#include <linux/bitfield.h>
+#include <linux/of_net.h>
+#include <net/cfg80211.h>
+#include <net/mac80211.h>
+/*
+ * No 6 GHz band exists here. The identifier is kept usable for the many
+ * comparisons in the shared connac code, but it is never published through
+ * wiphy->bands[] so no code can ever index with it.
+ */
+#define NL80211_BAND_6GHZ NUM_NL80211_BANDS
+/*
+ * Marker for "firmware already stripped the 802.11 header". The RX header
+ * translation feature is switched off for this build (see mt7921/init.c), so
+ * this only ever stays clear; the bit is outside the flags this mac80211
+ * defines and therefore cannot collide with anything.
+ */
+#ifndef RX_FLAG_8023
+#define RX_FLAG_8023 BIT(28)
+#endif
+/* field helpers ------------------------------------------------------------------ */
+#ifndef u8_encode_bits
+#define u8_encode_bits(val, mask)FIELD_PREP(mask, val)
+#endif
+#ifndef u16_encode_bits
+#define u16_encode_bits(val, mask)FIELD_PREP(mask, val)
+#endif
+#ifndef u32_encode_bits
+#define u32_encode_bits(val, mask)FIELD_PREP(mask, val)
+#endif
+/* compiler statement attribute (5.4+) */
+#ifndef fallthrough
+#define fallthrough do { } while (0)
+#endif
+/* ktime_get_boottime_ns (5.7+) */
+#ifndef ktime_get_boottime_ns
+#define ktime_get_boottime_ns()ktime_to_ns(ktime_get_boottime())
+#endif
+/* sched_set_fifo_low (5.9+): raise the tx worker to low RT priority */
+static inline void mt76_sched_set_fifo_low(struct task_struct *task)
+{
+	struct sched_param param = { .sched_priority = 1 };
+
+	sched_setscheduler_nocheck(task, SCHED_FIFO, &param);
+}
+/* ieee80211_disconnect (5.2+): this kernel reports a lost connection instead,
+ * which makes mac80211 tear the association down and reassociate. */
+static inline void mt76_ieee80211_disconnect(struct ieee80211_vif *vif,
+					     bool reconnect)
+{
+	ieee80211_connection_loss(vif);
+}
