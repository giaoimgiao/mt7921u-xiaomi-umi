diff -ruN a/mt76/Kconfig b/mt76/Kconfig
--- a/mt76/Kconfig	1970-01-01 00:00:00.000000000 +0000
+++ b/mt76/Kconfig	2026-10-14 20:32:42.094791362 +0000
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: GPL-2.0
+# Local Kconfig glue for the backported mt76 tree: only the components needed
+# for the USB 802.11ax part are exposed.
+
+config MT76_CORE
+	tristate
+	depends on MAC80211
+	select FW_LOADER
+
+config MT76_USB
+	tristate
+	depends on USB
+	select MT76_CORE
+
+config MT76_SDIO
+	tristate
+	select MT76_CORE
+
+config MT76_CONNAC_LIB
+	tristate
+	select MT76_CORE
+
+config MT76x02_LIB
+	tristate
+	select MT76_CORE
+
+config MT76x02_USB
+	tristate
+	select MT76x02_LIB
+
+source "drivers/net/wireless/mediatek/mt76/mt7921/Kconfig"
\ No newline at end of file
