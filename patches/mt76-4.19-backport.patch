diff -ruN a/mt76/mt76_wed_compat.h b/mt76/mt76_wed_compat.h
--- a/mt76/mt76_wed_compat.h	1970-01-01 00:00:00.000000000 +0000
+++ b/mt76/mt76_wed_compat.h	2026-10-14 21:13:09.666790436 +0000
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: ISC
+ *
+ * Minimal stand-in for <linux/soc/mediatek/mtk_wed.h>.
+ *
+ * WED is the MT7915/MT7622 ethernet-dispatch engine. It only matters for the
+ * PCIe/MMIO front-ends, which this build does not use (USB only). The kernel we
+ * target predates the header entirely, so we provide an inert local version:
+ * every entry point reports "not active", which makes the mmio/dma glue fall
+ * back to plain DMA paths exactly as on a device without WED.
+ */
+#ifndef __MT76_WED_COMPAT_H
+#define __MT76_WED_COMPAT_H
+
+#include <linux/types.h>
+
+struct mtk_wed_device {
+	struct {
+		/* first token owned by WED */
+		u16 token_start;
+	} wlan;
+	struct {
+		u32 reg_base;
+	} tx_ring[8];
+
+	struct {
+		u32 reg_base;
+	} txfree_ring;
+};
+
+static inline bool mtk_wed_device_active(struct mtk_wed_device *dev)
+{
+	return false;
+}
+
+static inline u32 mtk_wed_device_reg_read(struct mtk_wed_device *dev, u32 reg)
+{
+	return ~0;
+}
+
+static inline void mtk_wed_device_reg_write(struct mtk_wed_device *dev,
+					    u32 reg, u32 val)
+{
+}
+
+static inline int mtk_wed_device_irq_set_mask(struct mtk_wed_device *dev,
+					      u32 mask)
+{
+	return 0;
+}
+
+static inline int mtk_wed_device_tx_ring_setup(struct mtk_wed_device *dev,
+					       int idx, void __iomem *regs)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void mtk_wed_device_detach(struct mtk_wed_device *dev)
+{
+}
+
+static inline int mtk_wed_device_txfree_ring_setup(struct mtk_wed_device *dev,
+						   void __iomem *regs)
+{
+	return -EOPNOTSUPP;
+}
+
+#endif /* __MT76_WED_COMPAT_H */
