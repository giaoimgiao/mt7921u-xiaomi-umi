+/* ieee80211_get_he_iftype_cap() does not exist here: same lookup, local */
+static inline const struct ieee80211_sta_he_cap *
+mt76_get_he_iftype_cap(struct ieee80211_supported_band *sband, u32 iftype)
+{
+	int i;
+
+	if (!sband || !sband->iftype_data)
+		return NULL;
+
+	for (i = 0; i < sband->n_iftype_data; i++) {
+		if (sband->iftype_data[i].types_mask & BIT(iftype))
+			return &sband->iftype_data[i].he_cap;
+	}
+
+	return NULL;
+}
